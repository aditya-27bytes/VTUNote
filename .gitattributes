# Auto detect text files and perform LF normalization
* text=auto

# Custom for Visual Studio
*.cs diff=csharp
*.sln merge=union
*.csproj merge=union
*.vbproj merge=union
*.fsproj merge=union
*.dbproj merge=union

# Standard to msysgit
*.docx diff=astextplain
*.DOCX diff=astextplain
*.xlsx diff=astextplain
*.XLSX diff=astextplain
*.pptx diff=astextplain
*.PPTX diff=astextplain

# PDF files
*.pdf diff=astextplain

# Markdown files
*.md text=auto eol=lf

# JavaScript files
*.js text=auto eol=lf

# TypeScript files
*.ts text=auto eol=lf

# JSON files
*.json text=auto eol=lf

# HTML files
*.html text=auto eol=lf

# CSS files
*.css text=auto eol=lf

# SCSS files
*.scss text=auto eol=lf

# Configuration files
*.yml text=auto eol=lf
*.yaml text=auto eol=lf
*.toml text=auto eol=lf
*.ini text=auto eol=lf

# Environment files
*.env text=auto eol=lf

# Git files
.gitattributes text=auto eol=lf
.gitignore text=auto eol=lf
.gitmodules text=auto eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.svg text eol=lf