MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# NOTE: If your username or password contains special characters (@, :, /, ?, #, [, ], %),
# you MUST URL encode them:
# @ -> %40
# : -> %3A
# / -> %2F
# ? -> %3F
# # -> %23
# [ -> %5B
# ] -> %5D
# % -> %25

# EXAMPLE WITH SPECIAL CHARACTERS:
# If your username is "user:pass@27", it should be encoded as "user%3Apass%4027"
# If your password is "aditya@27", it should be encoded as "aditya%4027"

JWT_SECRET=your_jwt_secret_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar
HF_API_KEY=your_huggingface_api_key_here
PORT=5000
NODE_ENV=development

# ============ EMAIL SERVICE CONFIGURATION (Gmail SMTP) ============
# For Gmail SMTP with App Password:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Visit: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Generate the 16-character app password
# 5. Copy the app password and paste below (remove spaces)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ============ GOOGLE OAUTH CONFIGURATION ============
# To set up Google OAuth:
# 1. Go to: https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add Authorized JavaScript origins:
#    - http://localhost:3000 (development)
#    - https://yourdomain.com (production)
# 6. Add Authorized redirect URIs:
#    - http://localhost:5000/auth/google/callback (development)
#    - https://yourdomain.com/auth/google/callback (production)
# 7. Copy Client ID and Client Secret below
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here